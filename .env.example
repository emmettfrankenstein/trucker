# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
TOMTOM_API_KEY=your-tomtom-key   # free at https://developer.tomtom.com

# Optional (defaults shown)
# DATABASE_URL=sqlite:///db.sqlite3
# REDIS_URL=redis://localhost:6379/0
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# RISK_WIND_FIELD=sustained        # or "gust"
# HEATMAP_BUFFER_MI=30
# HEATMAP_MAX_CELLS=250
# OPEN_METEO_API_KEY=               # optional paid key; removes the free tier's per-minute limit
# OPEN_METEO_LOCATIONS_PER_MINUTE=580
# OPEN_METEO_MAX_LOCATIONS_PER_REQUEST=300
